# Дашборд прозвона. Скопировать в .env и заполнить.
# Пустое значение означает «не задано»: источник просто выключается.

# --- Что считаем ---
DASH_PLAN_CALLS_PER_DAY=120
DASH_TALK_THRESHOLD_SEC=15
# Сколько минут после звонка правка карточки считается сделанной по этому звонку.
# Значение нужно согласовать с владельцем — сейчас взято наугад.
DASH_CARD_WINDOW_MIN=30
DASH_TIMEZONE_OFFSET_HOURS=3

# --- ВАТС МегаФон ---
# Тот же ключ, что у сервиса ASR: поле «Ключ для авторизации в АТС» в кабинете.
DASH_VATS_URL=https://vats247306.megapbx.ru/crmapi/v1
DASH_VATS_API_TOKEN=
DASH_POLL_INTERVAL_SEC=300

# --- Synergy CRM ---
DASH_SYNERGY_URL=https://app.synergycrm.ru/api/v1
DASH_SYNERGY_API_TOKEN=
DASH_SYNERGY_GROUP=Тёплый прозвон
# Идентификаторы кастомных полей карточки контакта. Берутся из кабинета Synergy,
# у каждой установки свои. Вид: custom-12345
DASH_FIELD_NEED=
DASH_FIELD_FREQUENCY=
DASH_FIELD_OBJECTS=
DASH_FIELD_INN=

# --- Разбор разговоров ---
DASH_ASR_URL=http://127.0.0.1:8080
# Не распознавать звонки короче. Короткие почти не несут содержания,
# а процессорное время съедают. 0 — распознавать все.
DASH_TRANSCRIBE_MIN_DURATION_SEC=60
# Выключено намеренно: на 4 ядрах разбор не помещается в сутки при плане 120.
# Расчёт в PLAN.md. Включать только после решения по нагрузке.
DASH_TRANSCRIBE_ENABLED=false

# --- Прочее ---
DASH_DB_PATH=data/dashboard.db
# Показательные данные, пока нет настоящих источников. Выключить, когда появятся.
DASH_DEMO_MODE=true
DASH_LOG_LEVEL=INFO
