[Unit]
Description=Дашборд: баланс расчётов с покупателями из 1С в поля компании «Баланс по СК» и «Баланс по АЛ» (Synergy)
After=network-online.target
OnFailure=dashboard-balances-alert.service

[Service]
Type=oneshot
# Под agent: у него ключ ssh на офисный сервер (1С читается там). Запись в базу и Synergy — через sudo -u claude внутри.
User=agent
Group=claude
UMask=0002
WorkingDirectory=/home/claude/dashboard
ExecStart=/usr/bin/flock -w 1200 /tmp/dashboard-1c.lock /home/claude/dashboard/scripts/pull_1c_balances.sh
TimeoutStartSec=40min
