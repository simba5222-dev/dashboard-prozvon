[Unit]
Description=Дашборд: сводный отчёт владельцу по менеджерам за неделю
After=network-online.target

[Service]
Type=oneshot
User=claude
Group=claude
UMask=0002
WorkingDirectory=/home/claude/dashboard
ExecStart=/home/claude/dashboard/.venv/bin/python scripts/manager_digest.py --period weekly --apply
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
